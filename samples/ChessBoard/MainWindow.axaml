<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ChessBoard"
        x:Class="ChessBoard.MainWindow"
        x:DataType="local:GameViewModel"
        Title="Chess" Width="760" Height="560">
  <Design.DataContext>
    <local:GameViewModel />
  </Design.DataContext>
  <Grid ColumnDefinitions="Auto,*" Margin="16">
    <Border BorderBrush="#555" BorderThickness="2" Width="484" Height="484" VerticalAlignment="Top">
      <ItemsControl ItemsSource="{Binding Squares}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="8" Columns="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:Square">
            <Border Classes="square" Classes.light="{Binding IsLight}" Classes.selected="{Binding IsSelected}"
                    PointerPressed="Square_PointerPressed">
              <TextBlock Classes="piece" Text="{Binding Piece}" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="10">
      <TextBlock Text="{Binding Status}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Moves" Opacity="0.7" />
      <ListBox ItemsSource="{Binding Moves}" Height="300" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="NewGameButton" Content="New game" Click="NewGameButton_Click" />
        <Button x:Name="UndoButton" Content="Start over" Click="UndoButton_Click" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
