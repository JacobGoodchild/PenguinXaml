<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChessBoard.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <SolidColorBrush x:Key="LightSquare">#EEEED2</SolidColorBrush>
    <SolidColorBrush x:Key="DarkSquare">#769656</SolidColorBrush>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Border.square">
      <Setter Property="Background" Value="{StaticResource DarkSquare}" />
    </Style>
    <Style Selector="Border.square.light">
      <Setter Property="Background" Value="{StaticResource LightSquare}" />
    </Style>
    <Style Selector="Border.square.selected">
      <Setter Property="BorderBrush" Value="#F2A33A" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="TextBlock.piece">
      <Setter Property="FontSize" Value="34" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Application.Styles>
</Application>
